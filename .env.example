# Copy this file to ".env" and fill in the values. Never commit ".env".

# From Google Cloud Console > APIs & Services > Credentials (OAuth client ID, Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" in Google Cloud Console
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Any long random string, e.g. output of: openssl rand -hex 32
JWT_SECRET=change-me

# Comma-separated Google emails that get the ADMIN role on login
ADMIN_EMAILS=you@gmail.com

# Public address of the web app (used for the post-login redirect)
WEB_URL=http://localhost:3000
